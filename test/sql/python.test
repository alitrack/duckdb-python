# name: test/sql/python.test
# description: smoke tests for the python extension
# group: [python]

# ── Load gating ─────────────────────────────────────────────

statement error
SELECT py_eval('x.upper()', 'sam');
----
Catalog Error: Scalar Function with name py_eval does not exist!

require python

# ── py_register known broken — pre-existing bug ──────────────
# See: https://github.com/alitrack/duckdb-python/issues

# ── py_eval: scalar ─────────────────────────────────────────

query T
SELECT py_eval('x.upper()', 'sam');
----
SAM

query T
SELECT py_eval('x[::-1]', 'hello');
----
olleh

query T
SELECT py_eval('str(int(x)*3)', '7');
----
21

query T
SELECT py_eval('x.upper()', NULL);
----
NULL

# ── py_register + direct call (typed return) ──────────────────

query T
SELECT py_register('double_it', 'str(int(x)*2)', 1, NULL);
----
OK

query T
SELECT double_it('21');
----
42

# typed: BIGINT
query T
SELECT py_register('dbl', 'int(x)*2', 1, 'BIGINT');
----
OK

query I
SELECT dbl('21');
----
42

# typed: DOUBLE
query T
SELECT py_register('half', 'round(float(x)/2,2)', 1, 'DOUBLE');
----
OK

query R
SELECT half('99');
----
49.5

# ── py_map: batch scalar ─────────────────────────────────────

query T
SELECT py_map('[s.upper() for s in x]', 'hello');
----
HELLO

query T
SELECT py_map('[str(int(n)*2) for n in x]', '5');
----
10

# ── py_agg: aggregate ────────────────────────────────────────

query T
SELECT py_agg('a', 'state.get(chr(115),0)+int(x)', 'str(state.get(chr(115),0))') FROM (VALUES ('1'),('2'),('3')) t(a);
----
6
