# name: test/sql/pyudf.test
# description: smoke tests for the pyudf extension
# group: [pyudf]

# ── Load gating ─────────────────────────────────────────────

statement error
SELECT py_eval('x.upper()', 'sam');
----
Catalog Error: Scalar Function with name py_eval does not exist!

require pyudf

# ── py_eval: scalar ─────────────────────────────────────────

query T
SELECT py_eval('x.upper()', 'sam');
----
SAM

query T
SELECT py_eval('x[::-1]', 'hello');
----
olleh

query T
SELECT py_eval('str(int(x)*3)', '7');
----
21

# NULL input → NULL
query T
SELECT py_eval('x.upper()', NULL);
----
NULL

# Empty string
query T
SELECT py_eval('x.upper()', '');
----
(empty)

# ── py_register + direct call ────────────────────────────────

query T
SELECT py_register('double_it', 'str(int(x)*2)', 1);
----
OK

# direct call (v1.2+)
query T
SELECT double_it('21');
----
42

# backward-compatible py_call
query T
SELECT py_call('double_it', '21');
----
42

# register overwrite
query T
SELECT py_register('double_it', 'str(int(x)*10)', 1);
----
OK

query T
SELECT double_it('3');
----
30

# py_call with unregistered function
query T
SELECT py_call('nonexistent', 'x');
----
ERROR: function 'nonexistent' not registered

# ── py_list_functions ────────────────────────────────────────

query T
SELECT py_list_functions();
----
double_it

# ── py_map: batch scalar ─────────────────────────────────────

query T
SELECT py_map('[s.upper() for s in x]', 'hello');
----
HELLO

query T
SELECT py_map('[str(int(n)*2) for n in x]', '5');
----
10

# ── py_agg: aggregate ────────────────────────────────────────

query T
SELECT py_agg('a', 'state["s"]=state.get("s",0)+int(x)', 'str(state["s"])') FROM (VALUES ('1'),('2'),('3')) t(a);
----
6

# ── py_activate_venv ─────────────────────────────────────────

# non-existent path → error
query T
SELECT py_activate_venv('/nonexistent/venv');
----
ERROR: No site-packages found in /nonexistent/venv
